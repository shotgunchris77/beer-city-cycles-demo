{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "black",
          "color": "#EDE2C8",
          "name": "Paper (page background)"
        },
        {
          "slug": "coal",
          "color": "#F6EEDA",
          "name": "Card"
        },
        {
          "slug": "iron",
          "color": "#E3D6B6",
          "name": "Sand"
        },
        {
          "slug": "smoke",
          "color": "#17130F",
          "name": "Ink line"
        },
        {
          "slug": "cream",
          "color": "#17130F",
          "name": "Ink (headings)"
        },
        {
          "slug": "bone",
          "color": "#2A231B",
          "name": "Body text"
        },
        {
          "slug": "ash",
          "color": "#6A5E4C",
          "name": "Muted text"
        },
        {
          "slug": "gold",
          "color": "#BF3A12",
          "name": "Poster red"
        },
        {
          "slug": "brass",
          "color": "#C98A1E",
          "name": "Gold"
        },
        {
          "slug": "blaze",
          "color": "#D2401C",
          "name": "Blaze orange"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vh",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "size": "0.5rem",
          "name": "XXS"
        },
        {
          "slug": "20",
          "size": "1rem",
          "name": "XS"
        },
        {
          "slug": "30",
          "size": "clamp(1.25rem, 3vw, 2rem)",
          "name": "S"
        },
        {
          "slug": "40",
          "size": "clamp(1.75rem, 4vw, 3rem)",
          "name": "M"
        },
        {
          "slug": "50",
          "size": "clamp(2.5rem, 6vw, 4.5rem)",
          "name": "L"
        },
        {
          "slug": "60",
          "size": "clamp(3.25rem, 8vw, 6rem)",
          "name": "XL"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Alfa Slab One (headings)",
          "fontFamily": "\"Alfa Slab One\", Rockwell, \"Roboto Slab\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Alfa Slab One",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/alfa-slab-one-400.woff2"
              ]
            }
          ]
        },
        {
          "slug": "rye",
          "name": "Rye (poster accent)",
          "fontFamily": "\"Rye\", \"Alfa Slab One\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Rye",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/rye-400.woff2"
              ]
            }
          ]
        },
        {
          "slug": "script",
          "name": "Yellowtail (script accent)",
          "fontFamily": "\"Yellowtail\", \"Brush Script MT\", cursive",
          "fontFace": [
            {
              "fontFamily": "Yellowtail",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/yellowtail-400.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Courier Prime (body)",
          "fontFamily": "\"Courier Prime\", \"Courier New\", Courier, monospace",
          "fontFace": [
            {
              "fontFamily": "Courier Prime",
              "fontWeight": "400 500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/courier-prime-400.woff2"
              ]
            },
            {
              "fontFamily": "Courier Prime",
              "fontWeight": "600 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/courier-prime-700.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.9rem",
          "name": "Small",
          "fluid": false
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Body",
          "fluid": false
        },
        {
          "slug": "large",
          "size": "1.15rem",
          "name": "Large",
          "fluid": {
            "min": "1.05rem",
            "max": "1.15rem"
          }
        },
        {
          "slug": "x-large",
          "size": "1.6rem",
          "name": "Heading S",
          "fluid": {
            "min": "1.3rem",
            "max": "1.6rem"
          }
        },
        {
          "slug": "xx-large",
          "size": "2.9rem",
          "name": "Heading M",
          "fluid": {
            "min": "1.9rem",
            "max": "2.9rem"
          }
        },
        {
          "slug": "huge",
          "size": "4.2rem",
          "name": "Heading L",
          "fluid": {
            "min": "2.3rem",
            "max": "4.2rem"
          }
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--black)",
      "text": "var(--wp--preset--color--bone)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1",
          "textTransform": "uppercase",
          "letterSpacing": "0"
        },
        "color": {
          "text": "var(--wp--preset--color--cream)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--huge)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.05rem",
          "letterSpacing": "0.06em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--gold)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--cream)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--gold)",
          "text": "var(--wp--preset--color--black)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "fontSize": "0.95rem",
          "textTransform": "uppercase",
          "letterSpacing": "0.1em",
          "lineHeight": "1"
        },
        "border": {
          "radius": "0"
        },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "bottom": "0.95rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--cream)",
            "text": "var(--wp--preset--color--black)"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "fontSize": "0.95rem",
          "textTransform": "uppercase",
          "letterSpacing": "0.12em"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": []
}