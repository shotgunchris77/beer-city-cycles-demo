{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "760px", "wideSize": "1240px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "black", "color": "#000000", "name": "Black" },
        { "slug": "coal", "color": "#0F0E0C", "name": "Coal" },
        { "slug": "iron", "color": "#1B1915", "name": "Iron" },
        { "slug": "smoke", "color": "#322D25", "name": "Smoke" },
        { "slug": "cream", "color": "#F2E8D2", "name": "Cream" },
        { "slug": "bone", "color": "#CFC5AE", "name": "Bone" },
        { "slug": "ash", "color": "#948B78", "name": "Ash" },
        { "slug": "gold", "color": "#D4942F", "name": "Gold" },
        { "slug": "brass", "color": "#A8721F", "name": "Brass" },
        { "slug": "blaze", "color": "#E3411B", "name": "Blaze Orange" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vh", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem", "name": "XXS" },
        { "slug": "20", "size": "1rem", "name": "XS" },
        { "slug": "30", "size": "clamp(1.25rem, 3vw, 2rem)", "name": "S" },
        { "slug": "40", "size": "clamp(1.75rem, 4vw, 3rem)", "name": "M" },
        { "slug": "50", "size": "clamp(2.5rem, 6vw, 4.5rem)", "name": "L" },
        { "slug": "60", "size": "clamp(3.25rem, 8vw, 6rem)", "name": "XL" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display", "name": "Big Shoulders Display (headings)",
          "fontFamily": "\"Big Shoulders Display\", Impact, \"Arial Narrow\", sans-serif",
          "fontFace": [ { "fontFamily": "Big Shoulders Display", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/big-shoulders-display-100-900.woff2"] } ]
        },
        {
          "slug": "script", "name": "Yellowtail (script accent)",
          "fontFamily": "\"Yellowtail\", \"Brush Script MT\", cursive",
          "fontFace": [ { "fontFamily": "Yellowtail", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/yellowtail-400.woff2"] } ]
        },
        {
          "slug": "body", "name": "Barlow (body)",
          "fontFamily": "\"Barlow\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            { "fontFamily": "Barlow", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-400.woff2"] },
            { "fontFamily": "Barlow", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-500.woff2"] },
            { "fontFamily": "Barlow", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-600.woff2"] },
            { "fontFamily": "Barlow", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-700.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.9rem", "name": "Small", "fluid": false },
        { "slug": "medium", "size": "1.0625rem", "name": "Body", "fluid": false },
        { "slug": "large", "size": "1.25rem", "name": "Large", "fluid": { "min": "1.125rem", "max": "1.3rem" } },
        { "slug": "x-large", "size": "2rem", "name": "Heading S", "fluid": { "min": "1.6rem", "max": "2rem" } },
        { "slug": "xx-large", "size": "3.25rem", "name": "Heading M", "fluid": { "min": "2.25rem", "max": "3.25rem" } },
        { "slug": "huge", "size": "5.5rem", "name": "Heading L", "fluid": { "min": "3rem", "max": "5.5rem" } }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--black)", "text": "var(--wp--preset--color--bone)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
    "spacing": { "blockGap": "1.25rem", "padding": { "left": "var(--wp--preset--spacing--30)", "right": "var(--wp--preset--spacing--30)" } },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "900", "lineHeight": "0.98", "textTransform": "uppercase", "letterSpacing": "0.01em" }, "color": { "text": "var(--wp--preset--color--cream)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h4": { "typography": { "fontSize": "1.35rem", "letterSpacing": "0.04em" } },
      "link": { "color": { "text": "var(--wp--preset--color--gold)" }, ":hover": { "color": { "text": "var(--wp--preset--color--cream)" } } },
      "button": {
        "color": { "background": "var(--wp--preset--color--gold)", "text": "var(--wp--preset--color--black)" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "800", "fontSize": "1.1rem", "textTransform": "uppercase", "letterSpacing": "0.07em", "lineHeight": "1" },
        "border": { "radius": "2px", "width": "0" },
        "spacing": { "padding": { "top": "0.95rem", "bottom": "0.95rem", "left": "1.6rem", "right": "1.6rem" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--cream)", "text": "var(--wp--preset--color--black)" } }
      }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "800", "fontSize": "1.15rem", "textTransform": "uppercase", "letterSpacing": "0.08em" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": []
}
